# ASTRONOVA Video System - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# FREE APIs (Required)
# ============================================

# Groq - FREE AI API (14,400 requests/day)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Pexels - FREE Stock Images/Videos (Unlimited)
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ============================================
# CHEAP APIs (Optional - for MoneyPrinterTurbo)
# ============================================

# DeepSeek - Very cheap AI ($0.14/1M tokens)
# Get your key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Together.ai - Cheap AI image generation ($0.0013/image)
# Get your key at: https://together.ai
TOGETHER_API_KEY=your_together_api_key_here

# ============================================
# OPTIONAL APIs
# ============================================

# FreeSound - Ambient sounds/music
# Get your key at: https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=your_freesound_api_key_here

# ElevenLabs - Premium TTS (limited free tier)
# Get your key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
